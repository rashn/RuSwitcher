<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- Inno Setup pads string-version resource values with spaces. Restrict the
         generated installer by its exact release filename instead; the embedded
         application binaries are checked separately by windows-apps-zip. -->
    <pe-file path="RuSwitcher-Setup-${version}-x64.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="RuSwitcher-Setup-${version}-arm64.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
