<Project Sdk="Microsoft.NET.Sdk">

  <!-- RuSwitcher for Windows. No external (NuGet) dependencies. Low-level engine (LL hook,
       SendInput injection, tray) is raw Win32 P/Invoke; WinForms (first-party .NET) is used
       only for the clipboard and the settings window. EnableWindowsTargeting lets it also
       compile on macOS (P/Invoke compiles, can't run) for a fast local compile-check; the real
       build/test/exe come from the windows-latest CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RuSwitcher.Win</RootNamespace>
    <AssemblyName>RuSwitcher</AssemblyName>
    <ApplicationIcon>Assets\RuSwitcher.ico</ApplicationIcon>
    <Product>RuSwitcher</Product>
    <Title>RuSwitcher for Windows</Title>
    <Description>Keyboard layout correction utility for Windows</Description>
    <AssemblyTitle>RuSwitcher for Windows</AssemblyTitle>
    <AssemblyDescription>Keyboard layout correction utility for Windows</AssemblyDescription>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>RuSwitcher</Company>
    <Authors>rashn</Authors>
    <Copyright>Copyright © rashn</Copyright>
    <RepositoryUrl>https://github.com/rashn/RuSwitcher</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- Windows track starts pre-1.0 (beta). Keep in sync with windows/version.json. -->
    <Version>0.9.2-beta.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Let the test project reach internal engine types (AutoConverter verdict, etc.). -->
    <InternalsVisibleTo Include="RuSwitcher.Win.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read only the focused element's IsPassword capability. No text/value is requested. -->
    <Reference Include="UIAutomationClient">
      <HintPath>$(windir)\Microsoft.NET\assembly\GAC_MSIL\UIAutomationClient\v4.0_4.0.0.0__31bf3856ad364e35\UIAutomationClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UIAutomationTypes">
      <HintPath>$(windir)\Microsoft.NET\assembly\GAC_MSIL\UIAutomationTypes\v4.0_4.0.0.0__31bf3856ad364e35\UIAutomationTypes.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
