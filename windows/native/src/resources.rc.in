#include <windows.h>

1 ICON "@RUSWITCHER_ICON_PATH@"

1 VERSIONINFO
 FILEVERSION @RUSWITCHER_VERSION_COMMA@
 PRODUCTVERSION @RUSWITCHER_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS @RUSWITCHER_FILE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RuSwitcher"
            VALUE "FileDescription", "RuSwitcher for Windows"
            VALUE "FileVersion", "@RUSWITCHER_VERSION@"
            VALUE "InternalName", "RuSwitcher"
            VALUE "LegalCopyright", "Copyright (c) 2026 RuSwitcher contributors"
            VALUE "OriginalFilename", "RuSwitcher.exe"
            VALUE "ProductName", "RuSwitcher"
            VALUE "ProductVersion", "@RUSWITCHER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
