#include <windows.h>

1 ICON "../../src/RuSwitcher.Win/Assets/RuSwitcher.ico"

1 VERSIONINFO
 FILEVERSION 0,10,0,1
 PRODUCTVERSION 0,10,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RuSwitcher"
            VALUE "FileDescription", "RuSwitcher for Windows"
            VALUE "FileVersion", "0.10.0-beta.1"
            VALUE "InternalName", "RuSwitcher"
            VALUE "OriginalFilename", "RuSwitcher.exe"
            VALUE "ProductName", "RuSwitcher"
            VALUE "ProductVersion", "0.10.0-beta.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
